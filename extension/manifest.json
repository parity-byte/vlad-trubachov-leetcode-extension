{
  "manifest_version": 3,
  "name": "Best LeetCode Explanations",
  "short_name": "LC Explanations",
  "version": "1.2",
  "description": "Instantly find lee215 and votrubac's best-explained LeetCode solutions. Two pills in the Solutions filter bar — 3000+ problems covered, zero sign-in.",
  "homepage_url": "https://leetcode.com/u/votrubac/",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["solutions.json", "lee-solutions.json"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
