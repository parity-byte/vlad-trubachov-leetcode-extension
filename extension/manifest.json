{
  "manifest_version": 3,
  "name": "Vlad's LeetCode Solutions",
  "short_name": "votrubac",
  "version": "1.1",
  "description": "Instantly surface votrubac's (Vlad Trubachov) top-rated solutions on any LeetCode problem — 1800+ problems covered, zero sign-in required.",
  "homepage_url": "https://leetcode.com/u/votrubac/",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["solutions.json"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
